{
  "name": "mermaid2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "converter:build": "node scripts/build-converter.mjs",
    "dev": "npm run converter:build && vite --host 127.0.0.1",
    "build": "npm run converter:build && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "workers:dev": "wrangler dev"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@d2lang/d2": "0.1.34",
    "dompurify": "^3.2.6",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "vite": "^7.1.0",
    "wrangler": "^4.144.0"
  }
}
